# ============================================================
# Streamlit Cloud secrets template
# 1. Copy this file to: .streamlit/secrets.toml
# 2. Fill in your real values
# 3. NEVER commit secrets.toml to git (it is in .gitignore)
#
# On Streamlit Community Cloud:
#   App → Settings → Secrets → paste the contents below
# ============================================================

# ── LLM (Groq — free at console.groq.com, no daily limit) ───────────────────
GROQ_API_KEY    = "gsk_..."
GROQ_API_KEY_2  = "gsk_..."   # optional second account for rotation

# ── LLM fallback (Google Gemini — free at aistudio.google.com) ──────────────
GOOGLE_API_KEY   = "AQ..."
GOOGLE_API_KEY_2 = "AQ..."    # optional second account

# ── Job search (JSearch — 200 free req/month at rapidapi.com) ───────────────
JSEARCH_API_KEY = "your-rapidapi-key"

# ── Supabase (supabase.com → Settings → API) ────────────────────────────────
SUPABASE_URL      = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
