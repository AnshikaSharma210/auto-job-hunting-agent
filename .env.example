# Copy to .env and fill in your real keys. NEVER commit .env to git.

# ── LLM provider: google (FREE) | openai ─────────────────────────────────
LLM_PROVIDER=google

# ── Embeddings: local (FREE, no API) | google | openai ───────────────────
# Use "local" to save Gemini quota (recommended on free tier).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Google Gemini — FREE, no credit card ─────────────────────────────────
# Get key in 30 seconds at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-1.5-flash

# ── OpenAI (only needed when provider = openai) ───────────────────────────
# Get from: https://platform.openai.com/api-keys  (paid)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Job source: mock | jsearch | adzuna ───────────────────────────────────
# mock    → built-in demo data, no API key (good for testing)
# jsearch → FREE 200 req/mo, pulls LinkedIn+Indeed+Glassdoor (recommended)
#           Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# adzuna  → FREE, good India coverage
#           Sign up: https://developer.adzuna.com/
JOB_SOURCE=mock

JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ── Limits ────────────────────────────────────────────────────────────────
MAX_RESULTS=10
MAX_LLM_RANKINGS=3
MAX_UPLOAD_MB=2
