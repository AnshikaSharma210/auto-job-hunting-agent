# Copy to .env and fill in your real keys. NEVER commit .env to git.

# ── LLM provider: google (FREE) | openai ─────────────────────────────────
LLM_PROVIDER=google

# ── Embeddings: local (FREE, no API) | google | openai ───────────────────
# Use "local" to save Gemini quota (recommended on free tier).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Google Gemini — FREE, no credit card ─────────────────────────────────
# Get key in 30 seconds at: https://aistudio.google.com/app/apikey
# Add multiple keys for automatic rotation when one hits the daily limit:
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_CHAT_MODEL=gemini-2.0-flash

# ── Groq — FREE, no daily quota (resets every minute) ────────────────────
# PRIMARY provider — tried before Gemini.
# Multiple keys from DIFFERENT accounts rotate automatically when one hits rate limit.
# Sign up free at: https://console.groq.com  (takes 60 seconds, no credit card)
# Models: llama-3.3-70b-versatile (best) | llama-3.1-8b-instant (fastest)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile


# Get from: https://platform.openai.com/api-keys  (paid)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Job source ────────────────────────────────────────────────────────────
# multi   → all available sources in parallel (recommended)
#           Includes: JSearch, Adzuna, Remotive, 70+ company career pages
# jsearch → LinkedIn + Indeed + Glassdoor via RapidAPI (200 req/mo free)
#           Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# adzuna  → Good India + global coverage (free)
#           Sign up: https://developer.adzuna.com/
# mock    → Built-in demo data, no API key needed (good for testing)
JOB_SOURCE=multi

JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ── Extended free sources (no API keys needed) ────────────────────────────
# ENABLE_REMOTIVE: remote tech roles from remotive.com (free, no auth)
ENABLE_REMOTIVE=true

# ENABLE_COMPANY_CAREERS: direct career pages via Greenhouse / Lever / Ashby
# Covers 70+ companies: Razorpay, Swiggy, Stripe, OpenAI, Freshworks, etc.
ENABLE_COMPANY_CAREERS=true

# Add your own companies (comma-separated Name:ats:slug):
# e.g. "My Startup:greenhouse:mystartup,Another Co:lever:anotherco"
COMPANY_LIST_EXTRA=

# ── Limits ────────────────────────────────────────────────────────────────
MAX_RESULTS=20
MAX_LLM_RANKINGS=3
MAX_UPLOAD_MB=2
